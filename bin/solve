#!/bin/bash
# Hands one Shortcut story to an agent running in Herdr.
#
#   solve workspaces     the workspaces Herdr already has, with each one's cwd
#   solve start          read one JSON object on stdin and start an agent there
#   solve status         every agent Solve started, and how far its branch has got
#   solve pr             read {url, branch, dir} on stdin: the story's pull request, via gh
#   solve open-pr        read {dir, branch, base, title, body, draft}: push the branch, open its PR
#
# The object start reads is {workspaceId, cwd, worktree, kind, agent, branch,
# prompt}. worktree true checks out branch sc-<id> beside the repo; false opens
# a new tab in the workspace that is already there. Either way the agent is a
# new pane. An agent already named for this story is focused and not prompted
# again.
#
# This file never sees the Shortcut token. Herdr is a local socket. Both
# commands print one JSON object, {"ok": false, "code": ..., "error": ...} on
# failure, so the panel has exactly one thing to parse.

set -uo pipefail

fail() {
  jq -cn --arg error "$1" --arg code "${2:-error}" '{ok: false, code: $code, error: $error}'
  exit 1
}

command -v herdr >/dev/null 2>&1 || fail "Herdr is not installed" noherdr
command -v jq >/dev/null 2>&1 || fail "jq is required" error

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
HERDR_STATUS=0

# Herdr prints its answer on stdout and a JSON error on stderr. The status is
# remembered so a caller can tell "the agent is waiting" from "Herdr broke".
run_herdr() {
  HERDR_STATUS=0
  herdr "$@" >"$WORK/out.json" 2>"$WORK/err.json" || HERDR_STATUS=$?
  return "$HERDR_STATUS"
}

herdr_message() {
  local msg
  msg=$(jq -r '.error.message // empty' "$WORK/err.json" 2>/dev/null | head -1)
  [[ -n $msg ]] || msg=$(tr '\n' ' ' <"$WORK/err.json" | head -c 300)
  printf '%s' "${msg:-Herdr failed}"
}

herdr_code() {
  jq -r '.error.code // empty' "$WORK/err.json" 2>/dev/null | head -1
}

require_herdr() {
  [[ $HERDR_STATUS -eq 0 ]] || fail "$(herdr_message)" herdr
}

# Focus is best-effort: the agent is already running if this fails, and the
# panel then says so instead of claiming the keyboard has moved.
focus_agent() {
  run_herdr agent focus "$1"
  [[ $HERDR_STATUS -eq 0 ]]
}

cmd_workspaces() {
  run_herdr workspace list
  require_herdr
  cp "$WORK/out.json" "$WORK/ws.json"
  run_herdr pane list
  require_herdr
  cp "$WORK/out.json" "$WORK/panes.json"
  jq -n --slurpfile ws "$WORK/ws.json" --slurpfile panes "$WORK/panes.json" '
    ($ws[0].result.workspaces // []) as $workspaces
    | ($panes[0].result.panes // []) as $panes
    | {ok: true, workspaces: [
        $workspaces[] | . as $w
        | ($panes | map(select(.workspace_id == $w.workspace_id and ((.cwd // "") != ""))) | .[0].cwd // "") as $cwd
        | {id: $w.workspace_id, label: ($w.label // ""), cwd: $cwd}
      ]}' || fail "Herdr sent a workspace list that could not be read" herdr
}

# A fresh shell. An already-open worktree's root pane may be busy, so that
# case gets its own tab; a checkout we just created is a new shell already.
fresh_pane() {
  local ws=$1 cwd=$2
  local -a args=(tab create --workspace "$ws" --no-focus)
  [[ -n $cwd && $cwd == /* && $cwd != *$'\n'* ]] && args+=(--cwd "$cwd")
  run_herdr "${args[@]}"
  require_herdr
  jq -r '.result.root_pane.pane_id // empty' "$WORK/out.json"
}

cmd_start() {
  cat >"$WORK/body.json"
  local ws cwd worktree kind agent branch prompt
  ws=$(jq -r '.workspaceId // ""' "$WORK/body.json") || fail "start needs a JSON object" usage
  cwd=$(jq -r '.cwd // ""' "$WORK/body.json")
  worktree=$(jq -r '.worktree // false' "$WORK/body.json")
  kind=$(jq -r '.kind // ""' "$WORK/body.json")
  agent=$(jq -r '.agent // ""' "$WORK/body.json")
  branch=$(jq -r '.branch // ""' "$WORK/body.json")
  prompt=$(jq -r '.prompt // ""' "$WORK/body.json")

  [[ $ws =~ ^[A-Za-z0-9:_-]+$ ]] || fail "start needs a workspace id" usage
  [[ $agent =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || fail "start needs an agent name" usage
  [[ $branch =~ ^sc-[0-9]+$ ]] || fail "start needs a branch" usage
  [[ $kind =~ ^(grok|claude|codex|cursor|opencode)$ ]] || fail "start needs a known agent" usage
  [[ -n $prompt ]] || fail "start needs a prompt" usage

  run_herdr agent list
  require_herdr
  local existing
  existing=$(jq -r --arg name "$agent" \
    '[.result.agents[]? | select(.name == $name)] | .[0].agent_status // empty' "$WORK/out.json")
  if [[ -n $existing ]]; then
    local focused=false
    focus_agent "$agent" && focused=true
    jq -cn --arg status "$existing" --argjson focused "$focused" \
      '{ok: true, prompted: false, focused: $focused, status: $status, where: "existing"}'
    return
  fi

  local pane="" where="tab" tab_id=""
  if [[ $worktree == true ]]; then
    where=worktree
    run_herdr worktree list --workspace "$ws"
    require_herdr
    local found
    found=$(jq -r --arg branch "$branch" \
      '[.result.worktrees[]? | select(.branch == $branch)] | length' "$WORK/out.json")
    if [[ $found != 0 ]]; then
      run_herdr worktree open --workspace "$ws" --branch "$branch" --no-focus
    else
      run_herdr worktree create --workspace "$ws" --branch "$branch" --no-focus
    fi
    require_herdr
    local opened_ws path already
    opened_ws=$(jq -r '.result.workspace.workspace_id // empty' "$WORK/out.json")
    path=$(jq -r '.result.worktree.path // empty' "$WORK/out.json")
    already=$(jq -r '.result.already_open // false' "$WORK/out.json")
    pane=$(jq -r '.result.root_pane.pane_id // empty' "$WORK/out.json")
    tab_id=$(jq -r '.result.tab.tab_id // empty' "$WORK/out.json")
    [[ -n $opened_ws ]] || fail "Herdr did not open a worktree" herdr
    if [[ $already == true ]]; then
      pane=$(fresh_pane "$opened_ws" "$path")
      tab_id=$(jq -r '.result.tab.tab_id // empty' "$WORK/out.json")
    fi
  else
    pane=$(fresh_pane "$ws" "$cwd")
    tab_id=$(jq -r '.result.tab.tab_id // empty' "$WORK/out.json")
  fi
  [[ -n $pane ]] || fail "Herdr did not return a pane" herdr

  if ! run_herdr agent start "$agent" --kind "$kind" --pane "$pane"; then
    local code
    code=$(herdr_code)
    if [[ $code == agent_not_ready || $code == agent_blocked ]]; then
      local focused=false
      focus_agent "$agent" && focused=true
      jq -cn --arg where "$where" --arg tab "$tab_id" --arg pane "$pane" --argjson focused "$focused" \
        '{ok: true, prompted: false, focused: $focused, status: "blocked", where: $where, tabId: $tab, paneId: $pane}'
      return
    fi
    fail "$(herdr_message)" herdr
  fi

  if ! run_herdr agent prompt "$agent" "$prompt"; then
    local code
    code=$(herdr_code)
    if [[ $code == agent_blocked || $code == agent_not_ready ]]; then
      local focused=false
      focus_agent "$agent" && focused=true
      jq -cn --arg where "$where" --arg tab "$tab_id" --arg pane "$pane" --argjson focused "$focused" \
        '{ok: true, prompted: false, focused: $focused, status: "blocked", where: $where, tabId: $tab, paneId: $pane}'
      return
    fi
    fail "$(herdr_message)" herdr
  fi

  local focused=false
  focus_agent "$agent" && focused=true
  jq -cn --arg where "$where" --arg tab "$tab_id" --arg pane "$pane" --argjson focused "$focused" \
    '{ok: true, prompted: true, focused: $focused, status: "working", where: $where, tabId: $tab, paneId: $pane}'
}

# What git says about one story's branch, seen from the agent's directory:
# whether sc-<id> exists yet, how many commits it has on top of the branch it
# came from, and -- when that directory has it checked out -- whether there is
# work not committed. The base is origin's default branch where there is one,
# else main or master; with none of those, ahead is left unknown rather than
# counted against the wrong thing.
branch_json() {
  local dir=$1 branch=$2
  if [[ -z $dir || ! -d $dir ]] || ! git -C "$dir" rev-parse --git-dir >/dev/null 2>&1; then
    jq -cn --arg branch "$branch" '{name: $branch, repo: false, exists: false, ahead: null, dirty: null, checkedOut: false}'
    return
  fi
  local exists=false ahead=null dirty=null checked=false base="" current
  if git -C "$dir" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
    exists=true
    base=$(git -C "$dir" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
    if [[ -z $base ]]; then
      local b
      for b in main master; do
        if git -C "$dir" rev-parse --verify --quiet "refs/heads/$b" >/dev/null; then base=$b; break; fi
      done
    fi
    if [[ -n $base ]]; then
      ahead=$(git -C "$dir" rev-list --count "$base..refs/heads/$branch" 2>/dev/null) || ahead=null
      [[ $ahead =~ ^[0-9]+$ ]] || ahead=null
    fi
  fi
  current=$(git -C "$dir" branch --show-current 2>/dev/null)
  if [[ $current == "$branch" ]]; then
    checked=true
    if [[ -n $(git -C "$dir" status --porcelain 2>/dev/null | head -1) ]]; then dirty=true; else dirty=false; fi
  fi
  jq -cn --arg branch "$branch" --arg base "$base" --argjson exists "$exists" --argjson ahead "$ahead" \
    --argjson dirty "$dirty" --argjson checked "$checked" \
    '{name: $branch, repo: true, exists: $exists, base: (if $base == "" then null else $base end),
      ahead: $ahead, dirty: $dirty, checkedOut: $checked}'
}

# Every agent Solve named -- s<story id> -- with its Herdr status and its
# branch. Agents Solve did not start are left out: this is about stories.
# Local only: Herdr's socket and git, never the network, so it is cheap
# enough to ask every few seconds.
cmd_status() {
  run_herdr agent list
  require_herdr
  jq -c '[.result.agents[]? | select((.name // "") | test("^s[0-9]+$"))
          | {name, storyId: (.name[1:] | tonumber), status: (.agent_status // "unknown"),
             cwd: (.foreground_cwd // .cwd // ""), paneId: (.pane_id // ""),
             workspaceId: (.workspace_id // ""), focused: (.focused == true),
             seq: (.state_change_seq // 0)}]' \
    "$WORK/out.json" >"$WORK/agents.json" || fail "Herdr sent an agent list that could not be read" herdr

  local row dir id branches="[]"
  while IFS= read -r row; do
    [[ -n $row ]] || continue
    dir=$(jq -r .cwd <<<"$row")
    id=$(jq -r .storyId <<<"$row")
    branches=$(jq -c --argjson b "$(branch_json "$dir" "sc-$id")" '. + [$b]' <<<"$branches")
  done < <(jq -c '.[]' "$WORK/agents.json")

  jq -cn --slurpfile agents "$WORK/agents.json" --argjson branches "$branches" \
    '{ok: true, agents: [$agents[0] | to_entries[] | .value + {branch: $branches[.key]}]}'
}

# The fields gh is asked for, and what the panel is handed: GitHub's rollup
# of checks and reviews folded down to one word each, so the view has
# nothing to interpret. A check that failed in any way is failing; one still
# queued or running is pending; none at all is none.
PR_FIELDS=number,url,state,isDraft,title,reviewDecision,statusCheckRollup
PR_SHAPE='def checks:
    (.statusCheckRollup // []) as $all
    | if ($all | length) == 0 then "none"
      elif any($all[]; ((.conclusion // "") | IN("FAILURE","TIMED_OUT","CANCELLED","ACTION_REQUIRED","STARTUP_FAILURE"))
                       or ((.state // "") | IN("FAILURE","ERROR"))) then "failing"
      elif any($all[]; ((.status // "COMPLETED") != "COMPLETED") or ((.state // "") | IN("PENDING","EXPECTED"))) then "pending"
      else "passing" end;
  {number, url, title: (.title // ""), state: ((.state // "") | ascii_downcase),
   draft: (.isDraft == true), checks: checks,
   review: ((.reviewDecision // "") | ascii_downcase | if . == "" then "none" else . end)}'

# A story's pull request. The link on the story wins when there is one: it
# is what someone deliberately attached. Otherwise the branch Solve works
# on, looked up from the agent's directory so gh knows which repository.
# Either way it is gh that talks to GitHub; nothing here holds a token.
cmd_pr() {
  cat >"$WORK/body.json"
  local url branch dir
  url=$(jq -r '.url // ""' "$WORK/body.json" 2>/dev/null) || fail "pr needs a JSON object" usage
  branch=$(jq -r '.branch // ""' "$WORK/body.json")
  dir=$(jq -r '.dir // ""' "$WORK/body.json")

  if [[ -n $url ]]; then
    [[ $url =~ ^https://github\.com/[^/]+/[^/]+/pull/[0-9]+ ]] || fail "pr needs a GitHub pull request URL" usage
  elif [[ -n $branch ]]; then
    [[ $branch =~ ^sc-[0-9]+$ ]] || fail "pr needs a branch" usage
    [[ -n $dir && -d $dir ]] && git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 ||
      { jq -cn '{ok: true, pr: null}'; return; }
  else
    jq -cn '{ok: true, pr: null}'; return
  fi

  command -v gh >/dev/null 2>&1 || fail "Reading a pull request needs the GitHub CLI (gh)" missing

  if [[ -n $url ]]; then
    gh pr view "$url" --json "$PR_FIELDS" >"$WORK/pr.json" 2>"$WORK/pr.err" ||
      fail "$(head -1 "$WORK/pr.err" | tr -d '\r')" github
    jq -c "$PR_SHAPE | {ok: true, pr: .}" "$WORK/pr.json" || fail "gh sent a pull request that could not be read" github
  else
    (cd "$dir" && gh pr list --head "$branch" --state all --limit 1 --json "$PR_FIELDS") \
      >"$WORK/pr.json" 2>"$WORK/pr.err" || fail "$(head -1 "$WORK/pr.err" | tr -d '\r')" github
    jq -c "{ok: true, pr: (if length == 0 then null else (.[0] | $PR_SHAPE) end)}" "$WORK/pr.json" ||
      fail "gh sent a pull request that could not be read" github
  fi
}

# Pushes sc-<id> to origin and opens its pull request. The panel only calls
# this after you have read what it is about to send and pressed Enter: the
# agent was told not to push, so this is the one place that does. It pushes
# the branch by name, whichever directory has it checked out, and never with
# --force: a push GitHub refuses stops here, with git's reason. base empty
# means the repository's default branch.
cmd_open_pr() {
  cat >"$WORK/body.json"
  local dir branch base title draft
  dir=$(jq -r '.dir // ""' "$WORK/body.json" 2>/dev/null) || fail "open-pr needs a JSON object" usage
  branch=$(jq -r '.branch // ""' "$WORK/body.json")
  base=$(jq -r '.base // ""' "$WORK/body.json")
  title=$(jq -r '.title // "" | gsub("^\\s+|\\s+$"; "")' "$WORK/body.json")
  draft=$(jq -r '.draft == true' "$WORK/body.json")
  jq -r '.body // ""' "$WORK/body.json" >"$WORK/pr-body.md"

  [[ $branch =~ ^sc-[0-9]+$ ]] || fail "open-pr needs a story branch" usage
  [[ -n $title ]] || fail "A pull request needs a title" usage
  [[ -z $base || $base =~ ^[A-Za-z0-9._/-]+$ ]] || fail "open-pr needs a base branch name" usage
  [[ -n $dir && -d $dir ]] && git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 ||
    fail "That directory is not a git repository" git
  git -C "$dir" rev-parse --verify --quiet "refs/heads/$branch" >/dev/null ||
    fail "There is no $branch branch to push" git
  git -C "$dir" remote get-url origin >/dev/null 2>&1 || fail "The repository has no origin to push to" git
  command -v gh >/dev/null 2>&1 || fail "Opening a pull request needs the GitHub CLI (gh)" missing

  if ! git -C "$dir" push --quiet -u origin "refs/heads/$branch:refs/heads/$branch" 2>"$WORK/push.err"; then
    fail "Pushing $branch failed: $(grep -v '^\s*$' "$WORK/push.err" | tail -1)" git
  fi

  local -a args=(pr create --head "$branch" --title "$title" --body-file "$WORK/pr-body.md")
  [[ -n $base ]] && args+=(--base "$base")
  [[ $draft == true ]] && args+=(--draft)
  if ! (cd "$dir" && gh "${args[@]}") >"$WORK/created.txt" 2>"$WORK/pr.err"; then
    fail "The branch is pushed, but gh could not open the pull request: $(head -1 "$WORK/pr.err" | tr -d '\r')" github
  fi
  local url
  url=$(grep -oE 'https://github\.com/[^[:space:]]+/pull/[0-9]+' "$WORK/created.txt" | tail -1)
  [[ -n $url ]] || fail "gh did not say where the pull request is" github
  jq -cn --arg url "$url" '{ok: true, url: $url, number: ($url | capture("/pull/(?<n>[0-9]+)$").n | tonumber)}'
}

case ${1:-} in
  workspaces) cmd_workspaces ;;
  start) cmd_start ;;
  status) cmd_status ;;
  pr) cmd_pr ;;
  open-pr) cmd_open_pr ;;
  *) fail "usage: solve workspaces | solve start | solve status | solve pr | solve open-pr" usage ;;
esac
